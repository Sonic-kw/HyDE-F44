$HOME/.config/hypr/themes/theme.lua|> $HOME/.config/hypr/themes/colors.lua
os.execute("gsettings set org.gnome.desktop.interface icon-theme 'Tela-circle-yellow'")
os.execute("gsettings set org.gnome.desktop.interface gtk-theme 'Edge-Runner'")
os.execute("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")

