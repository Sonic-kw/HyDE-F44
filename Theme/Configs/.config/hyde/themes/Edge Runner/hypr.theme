            inactive_border = "rgba(5032ACff) rgba(1F5322ff) 45",
        },
        layout = "dwindle",
        resize_on_border = true,
    },
    group = {
        col = {
            border_active          = "rgba(FADA16ff) rgba(4DBD4Fff) 45",
